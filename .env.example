# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# SUPABASE CONFIGURATION
# Supabase loyihangiz boshqaruv panelidan (Project Settings -> API) olinadi.
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon/Public Key (Mijozlar va ommaviy API so'rovlari uchun, RLS amal qiladi)
SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Service Role Key (Faqat server-side xavfsiz boshqaruv va birinchi admin yaratish uchun)
# DIQQAT: Hech qachon brauzer yoki ommaviy kodga qo'shmang!
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Storage Bucket nomi (sukut bo'yicha: choyxona-media)
SUPABASE_STORAGE_BUCKET="choyxona-media"
